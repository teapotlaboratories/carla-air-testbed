<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>carla_air_bridge</name>
  <version>0.1.0</version>
  <description>Bridges the CARLA-Air simulator into a PX4-shaped ROS 2 graph via the Python 3.10 sim_bridge sidecar.</description>
  <maintainer email="aldwin@hermanudin.com">Aldwin Akbar</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>px4_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>interfaces</depend>
  <depend>cv_bridge</depend>
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
