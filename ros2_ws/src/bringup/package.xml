<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>bringup</name>
  <version>0.1.0</version>
  <description>Launch files that compose the testbed.</description>
  <maintainer email="aldwin@hermanudin.com">Aldwin Akbar</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>carla_air_bridge</depend>
  <depend>vlm_client</depend>
  <depend>grounding</depend>
  <depend>control</depend>
  <depend>evaluation</depend>
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
