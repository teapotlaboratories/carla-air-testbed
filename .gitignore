# ---- environment and tooling (rebuildable from scripts/) ----
# .venv/  : CPython 3.10 + the CARLA-Air client module, from scripts/setup_env.sh
# vendor/ : uv, the standalone CPython, and px4_msgs pinned by scripts/fetch_vendor.sh
.venv/
vendor/
.python-version

# ---- colcon workspace ----
# Regenerated by scripts/build_ros.sh in ~2 min. 207 MB against 364 KB of source, so it is
# never worth tracking. Anchored to ros2_ws/, and also matched at the repo root because
# colcon creates these in whatever directory it is invoked from.
ros2_ws/build/
ros2_ws/install/
ros2_ws/log/
/build/
/install/
/log/
*.egg-info/
*.egg-link

# ---- run artifacts ----
# out/ holds probe JSON, captured frames, episode results, flight videos and the sim log —
# evidence for one specific run, reproducible by re-running it. Cite the numbers in a
# worklog rather than committing the artifact.
out/

# Recordings and bags wherever they land. These get large fast: a single 58 s flight
# capture was 68 MB, and RGB-D at 640x480 is tens of GB per hour.
*.mp4
*.mcap
*.db3
*.bag
rosbag2_*/

# ---- python ----
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ---- secrets ----
# The next backend is a real VLM and will carry an API key. Keep it out of history from the
# start — rewriting history costs far more than adding the rule early.
.env
.env.*
!.env.example
*.key
*.pem
*credentials*
*secret*

# ---- editor / OS / crash residue ----
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
core
core.*
nohup.out
